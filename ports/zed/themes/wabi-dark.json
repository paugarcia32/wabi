        "editor.indent_guide_active": "#3b3934",
        "editor.document_highlight.read_background": "#7fa3cc26",
        "editor.document_highlight.write_background": "#d9775726",
        "editor.document_highlight.bracket_background": "#3b3934",

        "link_text.hover": "#7fa3cc",

        "terminal.background": "#1b1a18",
        "terminal.foreground": "#e8e6dc",
        "terminal.bright_foreground": "#faf9f5",
        "terminal.dim_foreground": "#a19e94",
        "terminal.ansi.black": "#2e2c28",
        "terminal.ansi.red": "#d16a6f",
        "terminal.ansi.green": "#99a874",
        "terminal.ansi.yellow": "#d5a65e",
        "terminal.ansi.blue": "#7fa3cc",
        "terminal.ansi.magenta": "#ae92b8",
        "terminal.ansi.cyan": "#82aa9c",
        "terminal.ansi.white": "#c8c5b9",
        "terminal.ansi.bright_black": "#8a877d",
        "terminal.ansi.bright_red": "#e0858a",
        "terminal.ansi.bright_green": "#adbb8a",
        "terminal.ansi.bright_yellow": "#e3ba79",
        "terminal.ansi.bright_blue": "#98b7d9",
        "terminal.ansi.bright_magenta": "#c2a8cb",
        "terminal.ansi.bright_cyan": "#9abfb1",
        "terminal.ansi.bright_white": "#faf9f5",

        "error": "#d16a6f",
        "error.background": "#d16a6f1a",
        "error.border": "#d16a6f4d",
        "warning": "#d5a65e",
        "warning.background": "#d5a65e1a",
        "warning.border": "#d5a65e4d",
        "info": "#7fa3cc",
        "info.background": "#7fa3cc1a",
        "info.border": "#7fa3cc4d",
        "hint": "#82aa9c",
        "hint.background": "#82aa9c1a",
        "hint.border": "#82aa9c4d",
        "success": "#99a874",
        "success.background": "#99a8741a",
        "success.border": "#99a8744d",

        "created": "#99a874",
        "created.background": "#99a8741a",
        "created.border": "#99a8744d",
        "modified": "#d5a65e",
        "modified.background": "#d5a65e1a",
        "modified.border": "#d5a65e4d",
        "deleted": "#d16a6f",
        "deleted.background": "#d16a6f1a",
        "deleted.border": "#d16a6f4d",
        "renamed": "#7fa3cc",
        "renamed.background": "#7fa3cc1a",
        "renamed.border": "#7fa3cc4d",
        "conflict": "#d97757",
        "conflict.background": "#d977571a",
        "conflict.border": "#d977574d",
        "ignored": "#8a877d",
        "hidden": "#8a877d",
        "unreachable": "#8a877d",
        "predictive": "#8a877d",

        "players": [
          { "cursor": "#d97757", "background": "#d97757", "selection": "#d9775733" },
          { "cursor": "#7fa3cc", "background": "#7fa3cc", "selection": "#7fa3cc33" },
          { "cursor": "#99a874", "background": "#99a874", "selection": "#99a87433" },
          { "cursor": "#ae92b8", "background": "#ae92b8", "selection": "#ae92b833" },
          { "cursor": "#82aa9c", "background": "#82aa9c", "selection": "#82aa9c33" },
          { "cursor": "#d5a65e", "background": "#d5a65e", "selection": "#d5a65e33" }
        ],

        "syntax": {
          "attribute": { "color": "#d5a65e" },
          "boolean": { "color": "#ae92b8" },
          "comment": { "color": "#8a877d", "font_style": "italic" },
          "comment.doc": { "color": "#a19e94", "font_style": "italic" },
          "constant": { "color": "#ae92b8" },
          "constructor": { "color": "#d5a65e" },
          "embedded": { "color": "#e8e6dc" },
          "emphasis": { "color": "#e8e6dc", "font_style": "italic" },
          "emphasis.strong": { "color": "#faf9f5", "font_weight": 700 },
          "enum": { "color": "#d5a65e" },
          "function": { "color": "#7fa3cc" },
          "hint": { "color": "#8a877d" },
          "keyword": { "color": "#d97757" },
          "label": { "color": "#82aa9c" },
          "link_text": { "color": "#7fa3cc" },
          "link_uri": { "color": "#82aa9c" },
          "number": { "color": "#ae92b8" },
          "operator": { "color": "#c8c5b9" },
          "predictive": { "color": "#8a877d", "font_style": "italic" },
          "preproc": { "color": "#d97757" },
          "primary": { "color": "#e8e6dc" },
          "property": { "color": "#c8c5b9" },
          "punctuation": { "color": "#a19e94" },
          "punctuation.bracket": { "color": "#a19e94" },
          "punctuation.delimiter": { "color": "#a19e94" },
          "punctuation.list_marker": { "color": "#d97757" },
          "punctuation.special": { "color": "#d97757" },
          "string": { "color": "#99a874" },
          "string.escape": { "color": "#82aa9c" },
          "string.regex": { "color": "#82aa9c" },
          "string.special": { "color": "#82aa9c" },
          "string.special.symbol": { "color": "#ae92b8" },
          "tag": { "color": "#d97757" },
          "text.literal": { "color": "#99a874" },
          "title": { "color": "#d97757", "font_weight": 700 },
          "type": { "color": "#d5a65e" },
          "variable": { "color": "#e8e6dc" },
          "variable.special": { "color": "#82aa9c" },
          "variant": { "color": "#d5a65e" }
        }
