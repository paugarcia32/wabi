{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Wabi Dark",
  "author": "paugarcia32",
  "themes": [
    {
      "name": "Wabi Dark",
      "appearance": "dark",
      "style": {
        "background": "#1b1a18",
        "border": "#3b3934",
        "border.variant": "#2e2c28",
        "border.focused": "#7fa3cc80",
        "border.selected": "#d9775780",
        "border.transparent": "#00000000",
        "border.disabled": "#2e2c28",

        "surface.background": "#1b1a18",
        "elevated_surface.background": "#23221f",
        "drop_target.background": "#d9775726",

        "element.background": "#2e2c28",
        "element.hover": "#3b3934",
        "element.active": "#4d4a44",
        "element.selected": "#3b3934",
        "element.disabled": "#2e2c28",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#2e2c28",
        "ghost_element.active": "#3b3934",
        "ghost_element.selected": "#2e2c28",
        "ghost_element.disabled": "#00000000",

        "text": "#e8e6dc",
        "text.muted": "#a19e94",
        "text.placeholder": "#8a877d",
        "text.disabled": "#8a877d",
        "text.accent": "#d97757",

        "icon": "#c8c5b9",
        "icon.muted": "#a19e94",
        "icon.disabled": "#8a877d",
        "icon.placeholder": "#8a877d",
        "icon.accent": "#d97757",

        "status_bar.background": "#1b1a18",
        "title_bar.background": "#1b1a18",
        "title_bar.inactive_background": "#141413",
        "toolbar.background": "#1b1a18",
        "tab_bar.background": "#1b1a18",
        "tab.inactive_background": "#1b1a18",
        "tab.active_background": "#23221f",
        "panel.background": "#1b1a18",
        "panel.focused_border": "#d9775780",
        "pane.focused_border": "#d9775780",
        "pane_group.border": "#3b3934",
        "search.match_background": "#d5a65e40",

        "scrollbar.thumb.background": "#a19e9433",
        "scrollbar.thumb.hover_background": "#a19e9459",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "#e8e6dc",
        "editor.background": "#1b1a18",
        "editor.gutter.background": "#1b1a18",
        "editor.subheader.background": "#23221f",
        "editor.active_line.background": "#23221f",
        "editor.highlighted_line.background": "#23221f",
        "editor.line_number": "#8a877d",
        "editor.active_line_number": "#c8c5b9",
        "editor.invisible": "#4d4a44",
