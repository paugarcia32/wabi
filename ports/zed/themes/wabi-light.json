{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Wabi Light",
  "author": "paugarcia32",
  "themes": [
    {
      "name": "Wabi Light",
      "appearance": "light",
      "style": {
        "background": "#f2f0e8",
        "border": "#dcd9cd",
        "border.variant": "#e8e6dc",
        "border.focused": "#3e6b9980",
        "border.selected": "#ab513480",
        "border.transparent": "#00000000",
        "border.disabled": "#e8e6dc",

        "surface.background": "#f2f0e8",
        "elevated_surface.background": "#f2f0e8",
        "drop_target.background": "#ab513426",

        "element.background": "#e8e6dc",
        "element.hover": "#dcd9cd",
        "element.active": "#c9c5b8",
        "element.selected": "#dcd9cd",
        "element.disabled": "#e8e6dc",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#e8e6dc",
        "ghost_element.active": "#dcd9cd",
        "ghost_element.selected": "#e8e6dc",
        "ghost_element.disabled": "#00000000",

        "text": "#2b2a27",
        "text.muted": "#5f5c55",
        "text.placeholder": "#6d6a63",
        "text.disabled": "#6d6a63",
        "text.accent": "#ab5134",

        "icon": "#45433e",
        "icon.muted": "#5f5c55",
        "icon.disabled": "#6d6a63",
        "icon.placeholder": "#6d6a63",
        "icon.accent": "#ab5134",

        "status_bar.background": "#f2f0e8",
        "title_bar.background": "#f2f0e8",
        "title_bar.inactive_background": "#efede4",
        "toolbar.background": "#faf9f5",
        "tab_bar.background": "#f2f0e8",
        "tab.inactive_background": "#f2f0e8",
        "tab.active_background": "#faf9f5",
        "panel.background": "#f2f0e8",
        "panel.focused_border": "#ab513480",
        "pane.focused_border": "#ab513480",
        "pane_group.border": "#dcd9cd",
        "search.match_background": "#8f661c40",

        "scrollbar.thumb.background": "#5f5c5533",
        "scrollbar.thumb.hover_background": "#5f5c5559",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "#2b2a27",
        "editor.background": "#faf9f5",
        "editor.gutter.background": "#faf9f5",
        "editor.subheader.background": "#f2f0e8",
        "editor.active_line.background": "#f2f0e8",
        "editor.highlighted_line.background": "#f2f0e8",
        "editor.line_number": "#6d6a63",
        "editor.active_line_number": "#45433e",
        "editor.invisible": "#c9c5b8",
        "editor.wrap_guide": "#e8e6dc",
        "editor.active_wrap_guide": "#dcd9cd",
        "editor.indent_guide": "#e8e6dc",
        "editor.indent_guide_active": "#dcd9cd",
        "editor.document_highlight.read_background": "#3e6b9926",
        "editor.document_highlight.write_background": "#ab513426",
        "editor.document_highlight.bracket_background": "#dcd9cd",

        "link_text.hover": "#3e6b99",

        "terminal.background": "#faf9f5",
        "terminal.foreground": "#2b2a27",
        "terminal.bright_foreground": "#141413",
        "terminal.dim_foreground": "#5f5c55",
        "terminal.ansi.black": "#45433e",
        "terminal.ansi.red": "#b0464f",
        "terminal.ansi.green": "#5c703e",
        "terminal.ansi.yellow": "#8f661c",
        "terminal.ansi.blue": "#3e6b99",
        "terminal.ansi.magenta": "#7c5c8c",
        "terminal.ansi.cyan": "#3d7566",
        "terminal.ansi.white": "#c9c5b8",
        "terminal.ansi.bright_black": "#6d6a63",
        "terminal.ansi.bright_red": "#963740",
        "terminal.ansi.bright_green": "#4b5d30",
        "terminal.ansi.bright_yellow": "#785412",
        "terminal.ansi.bright_blue": "#305982",
        "terminal.ansi.bright_magenta": "#684b77",
        "terminal.ansi.bright_cyan": "#2f6155",
        "terminal.ansi.bright_white": "#dcd9cd",

        "error": "#b0464f",
        "error.background": "#b0464f1a",
        "error.border": "#b0464f4d",
        "warning": "#8f661c",
        "warning.background": "#8f661c1a",
        "warning.border": "#8f661c4d",
        "info": "#3e6b99",
        "info.background": "#3e6b991a",
        "info.border": "#3e6b994d",
        "hint": "#3d7566",
        "hint.background": "#3d75661a",
        "hint.border": "#3d75664d",
        "success": "#5c703e",
        "success.background": "#5c703e1a",
        "success.border": "#5c703e4d",

        "created": "#5c703e",
        "created.background": "#5c703e1a",
        "created.border": "#5c703e4d",
        "modified": "#8f661c",
        "modified.background": "#8f661c1a",
        "modified.border": "#8f661c4d",
        "deleted": "#b0464f",
        "deleted.background": "#b0464f1a",
        "deleted.border": "#b0464f4d",
        "renamed": "#3e6b99",
        "renamed.background": "#3e6b991a",
        "renamed.border": "#3e6b994d",
        "conflict": "#ab5134",
        "conflict.background": "#ab51341a",
        "conflict.border": "#ab51344d",
        "ignored": "#6d6a63",
        "hidden": "#6d6a63",
        "unreachable": "#6d6a63",
        "predictive": "#6d6a63",

        "players": [
          { "cursor": "#ab5134", "background": "#ab5134", "selection": "#ab513433" },
          { "cursor": "#3e6b99", "background": "#3e6b99", "selection": "#3e6b9933" },
          { "cursor": "#5c703e", "background": "#5c703e", "selection": "#5c703e33" },
          { "cursor": "#7c5c8c", "background": "#7c5c8c", "selection": "#7c5c8c33" },
          { "cursor": "#3d7566", "background": "#3d7566", "selection": "#3d756633" },
          { "cursor": "#8f661c", "background": "#8f661c", "selection": "#8f661c33" }
        ],

        "syntax": {
          "attribute": { "color": "#8f661c" },
          "boolean": { "color": "#7c5c8c" },
          "comment": { "color": "#6d6a63", "font_style": "italic" },
          "comment.doc": { "color": "#5f5c55", "font_style": "italic" },
          "constant": { "color": "#7c5c8c" },
          "constructor": { "color": "#8f661c" },
          "embedded": { "color": "#2b2a27" },
          "emphasis": { "color": "#2b2a27", "font_style": "italic" },
          "emphasis.strong": { "color": "#141413", "font_weight": 700 },
          "enum": { "color": "#8f661c" },
          "function": { "color": "#3e6b99" },
          "hint": { "color": "#6d6a63" },
          "keyword": { "color": "#ab5134" },
          "label": { "color": "#3d7566" },
          "link_text": { "color": "#3e6b99" },
          "link_uri": { "color": "#3d7566" },
          "number": { "color": "#7c5c8c" },
          "operator": { "color": "#45433e" },
          "predictive": { "color": "#6d6a63", "font_style": "italic" },
          "preproc": { "color": "#ab5134" },
          "primary": { "color": "#2b2a27" },
          "property": { "color": "#45433e" },
          "punctuation": { "color": "#5f5c55" },
          "punctuation.bracket": { "color": "#5f5c55" },
          "punctuation.delimiter": { "color": "#5f5c55" },
          "punctuation.list_marker": { "color": "#ab5134" },
          "punctuation.special": { "color": "#ab5134" },
          "string": { "color": "#5c703e" },
          "string.escape": { "color": "#3d7566" },
          "string.regex": { "color": "#3d7566" },
          "string.special": { "color": "#3d7566" },
          "string.special.symbol": { "color": "#7c5c8c" },
          "tag": { "color": "#ab5134" },
          "text.literal": { "color": "#5c703e" },
          "title": { "color": "#ab5134", "font_weight": 700 },
          "type": { "color": "#8f661c" },
          "variable": { "color": "#2b2a27" },
          "variable.special": { "color": "#3d7566" },
          "variant": { "color": "#8f661c" }
        }
      }
    }
  ]
}
