{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "{{name}} {{Variant}}",
  "author": "paugarcia32",
  "themes": [
    {
      "name": "{{name}} {{Variant}}",
      "appearance": "{{variant}}",
      "style": {
        "background": "{{bg1}}",
        "border": "{{bg3}}",
        "border.variant": "{{bg2}}",
        "border.focused": "{{blue}}80",
        "border.selected": "{{orange}}80",
        "border.transparent": "#00000000",
        "border.disabled": "{{bg2}}",

        "surface.background": "{{bg1}}",
        "elevated_surface.background": "{{bg1}}",
        "drop_target.background": "{{orange}}26",

        "element.background": "{{bg2}}",
        "element.hover": "{{bg3}}",
        "element.active": "{{bg4}}",
        "element.selected": "{{bg3}}",
        "element.disabled": "{{bg2}}",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{bg2}}",
        "ghost_element.active": "{{bg3}}",
        "ghost_element.selected": "{{bg2}}",
        "ghost_element.disabled": "#00000000",

        "text": "{{fg}}",
        "text.muted": "{{fg2}}",
        "text.placeholder": "{{comment}}",
        "text.disabled": "{{comment}}",
        "text.accent": "{{orange}}",

        "icon": "{{fg1}}",
        "icon.muted": "{{fg2}}",
        "icon.disabled": "{{comment}}",
        "icon.placeholder": "{{comment}}",
        "icon.accent": "{{orange}}",

        "status_bar.background": "{{bg1}}",
        "title_bar.background": "{{bg1}}",
        "title_bar.inactive_background": "{{bg_dim}}",
        "toolbar.background": "{{bg0}}",
        "tab_bar.background": "{{bg1}}",
        "tab.inactive_background": "{{bg1}}",
        "tab.active_background": "{{bg0}}",
        "panel.background": "{{bg1}}",
        "panel.focused_border": "{{orange}}80",
        "pane.focused_border": "{{orange}}80",
        "pane_group.border": "{{bg3}}",
        "search.match_background": "{{yellow}}40",

        "scrollbar.thumb.background": "{{fg2}}33",
        "scrollbar.thumb.hover_background": "{{fg2}}59",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "{{fg}}",
        "editor.background": "{{bg0}}",
        "editor.gutter.background": "{{bg0}}",
        "editor.subheader.background": "{{bg1}}",
        "editor.active_line.background": "{{bg1}}",
        "editor.highlighted_line.background": "{{bg1}}",
        "editor.line_number": "{{comment}}",
        "editor.active_line_number": "{{fg1}}",
        "editor.invisible": "{{bg4}}",
        "editor.wrap_guide": "{{bg2}}",
        "editor.active_wrap_guide": "{{bg3}}",
        "editor.indent_guide": "{{bg2}}",
        "editor.indent_guide_active": "{{bg3}}",
        "editor.document_highlight.read_background": "{{blue}}26",
        "editor.document_highlight.write_background": "{{orange}}26",
        "editor.document_highlight.bracket_background": "{{bg3}}",

        "link_text.hover": "{{blue}}",

        "terminal.background": "{{bg0}}",
        "terminal.foreground": "{{fg}}",
        "terminal.bright_foreground": "{{fg0}}",
        "terminal.dim_foreground": "{{fg2}}",
        "terminal.ansi.black": "{{ansi_black}}",
        "terminal.ansi.red": "{{red}}",
        "terminal.ansi.green": "{{green}}",
        "terminal.ansi.yellow": "{{yellow}}",
        "terminal.ansi.blue": "{{blue}}",
        "terminal.ansi.magenta": "{{purple}}",
        "terminal.ansi.cyan": "{{aqua}}",
        "terminal.ansi.white": "{{ansi_white}}",
        "terminal.ansi.bright_black": "{{ansi_bright_black}}",
        "terminal.ansi.bright_red": "{{bright_red}}",
        "terminal.ansi.bright_green": "{{bright_green}}",
        "terminal.ansi.bright_yellow": "{{bright_yellow}}",
        "terminal.ansi.bright_blue": "{{bright_blue}}",
        "terminal.ansi.bright_magenta": "{{bright_purple}}",
        "terminal.ansi.bright_cyan": "{{bright_aqua}}",
        "terminal.ansi.bright_white": "{{ansi_bright_white}}",

        "error": "{{error}}",
        "error.background": "{{error}}1a",
        "error.border": "{{error}}4d",
        "warning": "{{warning}}",
        "warning.background": "{{warning}}1a",
        "warning.border": "{{warning}}4d",
        "info": "{{info}}",
        "info.background": "{{info}}1a",
        "info.border": "{{info}}4d",
        "hint": "{{hint}}",
        "hint.background": "{{hint}}1a",
        "hint.border": "{{hint}}4d",
        "success": "{{green}}",
        "success.background": "{{green}}1a",
        "success.border": "{{green}}4d",

        "created": "{{git_added}}",
        "created.background": "{{git_added}}1a",
        "created.border": "{{git_added}}4d",
        "modified": "{{git_modified}}",
        "modified.background": "{{git_modified}}1a",
        "modified.border": "{{git_modified}}4d",
        "deleted": "{{git_removed}}",
        "deleted.background": "{{git_removed}}1a",
        "deleted.border": "{{git_removed}}4d",
        "renamed": "{{blue}}",
        "renamed.background": "{{blue}}1a",
        "renamed.border": "{{blue}}4d",
        "conflict": "{{orange}}",
        "conflict.background": "{{orange}}1a",
        "conflict.border": "{{orange}}4d",
        "ignored": "{{comment}}",
        "hidden": "{{comment}}",
        "unreachable": "{{comment}}",
        "predictive": "{{comment}}",

        "players": [
          { "cursor": "{{orange}}", "background": "{{orange}}", "selection": "{{orange}}33" },
          { "cursor": "{{blue}}", "background": "{{blue}}", "selection": "{{blue}}33" },
          { "cursor": "{{green}}", "background": "{{green}}", "selection": "{{green}}33" },
          { "cursor": "{{purple}}", "background": "{{purple}}", "selection": "{{purple}}33" },
          { "cursor": "{{aqua}}", "background": "{{aqua}}", "selection": "{{aqua}}33" },
          { "cursor": "{{yellow}}", "background": "{{yellow}}", "selection": "{{yellow}}33" }
        ],

        "syntax": {
          "attribute": { "color": "{{yellow}}" },
          "boolean": { "color": "{{purple}}" },
          "comment": { "color": "{{comment}}", "font_style": "italic" },
          "comment.doc": { "color": "{{fg2}}", "font_style": "italic" },
          "constant": { "color": "{{purple}}" },
          "constructor": { "color": "{{yellow}}" },
          "embedded": { "color": "{{fg}}" },
          "emphasis": { "color": "{{fg}}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{fg0}}", "font_weight": 700 },
          "enum": { "color": "{{yellow}}" },
          "function": { "color": "{{blue}}" },
          "hint": { "color": "{{comment}}" },
          "keyword": { "color": "{{orange}}" },
          "label": { "color": "{{aqua}}" },
          "link_text": { "color": "{{blue}}" },
          "link_uri": { "color": "{{aqua}}" },
          "number": { "color": "{{purple}}" },
          "operator": { "color": "{{fg1}}" },
          "predictive": { "color": "{{comment}}", "font_style": "italic" },
          "preproc": { "color": "{{orange}}" },
          "primary": { "color": "{{fg}}" },
          "property": { "color": "{{fg1}}" },
          "punctuation": { "color": "{{fg2}}" },
          "punctuation.bracket": { "color": "{{fg2}}" },
          "punctuation.delimiter": { "color": "{{fg2}}" },
          "punctuation.list_marker": { "color": "{{orange}}" },
          "punctuation.special": { "color": "{{orange}}" },
          "string": { "color": "{{green}}" },
          "string.escape": { "color": "{{aqua}}" },
          "string.regex": { "color": "{{aqua}}" },
          "string.special": { "color": "{{aqua}}" },
          "string.special.symbol": { "color": "{{purple}}" },
          "tag": { "color": "{{orange}}" },
          "text.literal": { "color": "{{green}}" },
          "title": { "color": "{{orange}}", "font_weight": 700 },
          "type": { "color": "{{yellow}}" },
          "variable": { "color": "{{fg}}" },
          "variable.special": { "color": "{{aqua}}" },
          "variant": { "color": "{{yellow}}" }
        }
      }
    }
  ]
}
