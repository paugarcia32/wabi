  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "{{comment}}", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "{{green}}" }
    },
    {
      "name": "Escapes and regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "{{aqua}}" }
    },
    {
      "name": "Numbers and constants",
      "scope": ["constant.numeric", "constant.language", "constant.character", "support.constant", "variable.other.enummember"],
      "settings": { "foreground": "{{purple}}" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.expression", "keyword.other"],
      "settings": { "foreground": "{{orange}}" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "keyword.operator.assignment", "keyword.operator.arithmetic", "keyword.operator.logical", "keyword.operator.comparison"],
      "settings": { "foreground": "{{fg1}}" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "{{blue}}" }
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.name.class", "entity.other.inherited-class", "support.type", "support.class", "storage.type.primitive", "support.type.primitive", "entity.name.type.parameter"],
      "settings": { "foreground": "{{yellow}}" }
    },
    {
      "name": "Namespaces and modules",
      "scope": ["entity.name.namespace", "entity.name.module", "support.module", "entity.name.package"],
      "settings": { "foreground": "{{aqua}}" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite"],
      "settings": { "foreground": "{{fg}}" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "{{fg1}}" }
    },
    {
      "name": "Language variables (this, self)",
      "scope": ["variable.language", "support.variable"],
      "settings": { "foreground": "{{aqua}}" }
    },
    {
      "name": "Properties and object keys",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "support.type.property-name", "entity.name.tag.yaml"],
      "settings": { "foreground": "{{fg1}}" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "{{fg2}}" }
    },
    {
      "name": "String interpolation delimiters",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "{{orange}}" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "{{orange}}" }
    },
    {
      "name": "Attributes and decorators",
      "scope": ["entity.other.attribute-name", "meta.decorator", "entity.name.function.decorator", "punctuation.decorator"],
      "settings": { "foreground": "{{yellow}}" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "{{orange}}", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "{{fg0}}", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markup code",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "{{green}}" }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "{{aqua}}" }
    },
    {
      "name": "Markup quotes",
      "scope": ["markup.quote"],
      "settings": { "foreground": "{{fg2}}", "fontStyle": "italic" }
    },
    {
      "name": "Markup list markers",
      "scope": ["punctuation.definition.list.begin.markdown", "markup.list punctuation.definition"],
      "settings": { "foreground": "{{orange}}" }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": { "foreground": "{{git_added}}" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": { "foreground": "{{git_removed}}" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "{{git_modified}}" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "{{error}}" }
    }
  ],
  "semanticTokenColors": {
    "namespace": "{{aqua}}",
    "type": "{{yellow}}",
    "class": "{{yellow}}",
    "interface": "{{yellow}}",
    "enum": "{{yellow}}",
    "struct": "{{yellow}}",
    "typeParameter": "{{yellow}}",
    "enumMember": "{{purple}}",
    "function": "{{blue}}",
    "method": "{{blue}}",
    "macro": "{{orange}}",
    "decorator": "{{yellow}}",
    "parameter": "{{fg1}}",
    "property": "{{fg1}}",
    "variable": "{{fg}}",
    "variable.defaultLibrary": "{{aqua}}",
    "selfKeyword": "{{aqua}}",
    "keyword": "{{orange}}"
  }
}
